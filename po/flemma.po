# Flemma UI catalogue — user-facing strings that never reach the model:
# notifications, prompts, picker titles. This is the translatable surface.
# Model-facing strings live in po/flemma-harness.po and are not translation
# material. Keys must stay unique across both files; flemma.messages
# enforces this at load time.
# All keys are namespaced under ui.* — the call-site marker that a string
# is user-facing; harness keys never use this prefix.
msgid ""
msgstr ""
"Project-Id-Version: flemma\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "ui.usage.no_data"
msgstr "No usage data for this buffer."

msgid "ui.rejection.prompt"
msgstr "Flemma: Rejection reason (optional): "

msgid "ui.rejection.reject_failed"
msgstr "Reject failed"

msgid "ui.rejection.no_tool_call"
msgstr "No tool call found"

#. Variables: {{ tool_id }} — the tool call's identifier.
msgid "ui.rejection.no_result_placeholder"
msgstr "No tool result placeholder for {{ tool_id }}"

#. Variables: {{ tool_id }} — the tool call's identifier.
msgid "ui.rejection.already_completed"
msgstr "Tool {{ tool_id }} has already completed"

#. Variables: {{ tool_id }} — the tool call's identifier.
msgid "ui.rejection.no_fence"
msgstr "No fence found in tool result for {{ tool_id }}"

#. Tool-action feedback, shared by the keymaps and the :Flemma sub-commands.
msgid "ui.tool.execute_failed"
msgstr "Execution failed"

msgid "ui.tool.background_failed"
msgstr "Failed to move tool to background"

msgid "ui.tool.backgrounded"
msgstr "Tool moved to background."

msgid "ui.tool.approve_failed"
msgstr "Approve failed"

msgid "ui.tool.no_pending_approve"
msgstr "No pending tools to approve"

#. Shown on a cancel keypress that cancelled nothing; a second press within
#. the double-tap window cancels every tool in the buffer.
msgid "ui.tool.nothing_to_cancel_retry"
msgstr "Nothing to cancel (press again to cancel all)"

msgid "ui.tool.nothing_to_cancel"
msgstr "Nothing to cancel"

msgid "ui.tool.cancelled"
msgstr "Tool execution cancelled"

msgid "ui.tool.none_pending"
msgstr "No pending tool executions"

msgid "ui.tool.all_cancelled"
msgstr "All tool executions cancelled"

msgid "ui.tool.list_header"
msgstr "Pending tool executions:"

#. Variables: {{ tool_name }}, {{ tool_id }}, {{ seconds }} — one pending row.
msgid "ui.tool.list_row"
msgstr "  {{ tool_name }} ({{ tool_id }}) - started {{ seconds }}s ago"

#. :Flemma command dispatch and sub-command feedback.
#. Variables: {{ commands }} — comma-separated list of available commands.
msgid "ui.command.available"
msgstr "Available commands → {{ commands }}"

#. Variables: {{ command }} — the unrecognized command token.
msgid "ui.command.unknown"
msgstr "Unknown command '{{ command }}'"

#. Variables: {{ command }}, {{ suggestion }} — the closest known command.
msgid "ui.command.unknown_suggestion"
msgstr "Unknown command '{{ command }}'. Did you mean '{{ suggestion }}'?"

#. Variables: {{ command }} — a namespace node that has no action of its own.
msgid "ui.command.not_invokable"
msgstr "'{{ command }}' is not invokable"

#. Variables: {{ command }}, {{ subcommands }} — its available child commands.
msgid "ui.command.expects_subcommand"
msgstr "'{{ command }}' expects a sub-command ({{ subcommands }})"

#. Config action callbacks (on_request_start, on_request_complete, …).
#. Variables: {{ label }}, {{ reason }} — the callback name and failure detail.
msgid "ui.callback.failed"
msgstr "{{ label }} callback failed: {{ reason }}"

#. Variables: {{ label }}, {{ received }} — the callback name and the Lua type given.
msgid "ui.callback.invalid_type"
msgstr "{{ label }} expects a string or function, received {{ received }}"

#. Variables: {{ label }}, {{ reason }} — the callback name and failure detail.
msgid "ui.callback.command_failed"
msgstr "{{ label }} command failed: {{ reason }}"

#. :Flemma logging.
#. Variables: {{ level }} — the rejected level string.
msgid "ui.logging.invalid_level"
msgstr "Invalid log level '{{ level }}'. Valid levels: TRACE, DEBUG, INFO, WARN, ERROR"

#. Variables: {{ level }}, {{ path }} — the active level and the log file path.
msgid "ui.logging.enabled"
msgstr "Logging enabled (level: {{ level }}) - {{ path }}"

msgid "ui.logging.disabled"
msgstr "Logging disabled"

msgid "ui.logging.currently_disabled"
msgstr "Logging is currently disabled"

#. :Flemma switch — provider and model selection.
msgid "ui.provider.select_prompt"
msgstr "Select Provider:"

msgid "ui.provider.select_cancelled"
msgstr "Provider selection cancelled"

#. Variables: {{ provider }} — the selected provider name.
msgid "ui.provider.no_models"
msgstr "No models found for provider {{ provider }}"

#. Variables: {{ provider }} — the selected provider name.
msgid "ui.provider.select_model_prompt"
msgstr "Select Model for {{ provider }}:"

msgid "ui.provider.model_select_cancelled"
msgstr "Model selection cancelled"

#. Variables: {{ preset }} — the unknown preset token (e.g. '$fast').
msgid "ui.provider.unknown_preset"
msgstr "Unknown preset '{{ preset }}'"

#. Variables: {{ preset }}, {{ args }} — the preset and the ignored positionals.
msgid "ui.provider.ignoring_positionals_preset"
msgstr "Ignoring extra positional arguments for preset '{{ preset }}': {{ args }}"

msgid "ui.provider.name_required"
msgstr "Provider name required (use :Flemma switch <provider>)"

msgid "ui.provider.name_missing"
msgstr "Provider name is required"

#. Variables: {{ args }} — the ignored positional arguments.
msgid "ui.provider.ignoring_positionals"
msgstr "Ignoring extra positional arguments: {{ args }}"

#. Provider validation errors and the switch/initialize result notice
#. (core.lua) — a conditional header line followed by ⚠/ⓘ/• bullet lines.
#. Variables: {{ provider }}, {{ providers }} — the unknown name and the
#. comma-separated list of supported providers.
msgid "ui.provider.unknown"
msgstr "Unknown provider '{{ provider }}'. Supported providers are: {{ providers }}"

#. Variables: {{ model }}, {{ provider }}, {{ fallback }} — the rejected model,
#. its provider, and the default substituted in its place.
msgid "ui.provider.model_fallback"
msgstr "Model '{{ model }}' is not valid for provider '{{ provider }}'. Using default: '{{ fallback }}'."

#. Header after :Flemma switch. Paired forms: model resolved or not.
#. Variables: {{ provider }}, {{ model }}.
msgid "ui.provider.switched"
msgstr "Switched to '{{ provider }}'"

msgid "ui.provider.switched_with_model"
msgstr "Switched to '{{ provider }}' with model '{{ model }}'"

#. Header after initial provider setup. Paired forms: model resolved or not.
#. Variables: {{ provider }}, {{ model }}.
msgid "ui.provider.initialized"
msgstr "Initialized '{{ provider }}'"

msgid "ui.provider.initialized_with_model"
msgstr "Initialized '{{ provider }}' with model '{{ model }}'"

#. ⓘ bullet: the active provider bills against a subscription, not per-token.
msgid "ui.provider.subscription_notice"
msgstr "Flemma draws from your subscription usage limit"

#. ⚠ bullet: per-token pricing for a model over the high-cost threshold.
#. Variables: {{ pricing }} — the formatted input/output rate suffix.
msgid "ui.provider.billed_at"
msgstr "Billed at {{ pricing }}"

#. • bullet: buffer frontmatter overrides the session provider and/or model.
#. Three forms by which fields differ. Variables: {{ provider }}, {{ model }}.
msgid "ui.provider.frontmatter_override_provider"
msgstr "This buffer uses '{{ provider }}' (frontmatter)"

msgid "ui.provider.frontmatter_override_model"
msgstr "This buffer uses model '{{ model }}' (frontmatter)"

msgid "ui.provider.frontmatter_override_both"
msgstr "This buffer uses '{{ provider }}' / model '{{ model }}' (frontmatter)"

#. :Flemma diagnostics.
msgid "ui.diagnostics.enabled"
msgstr "Diagnostics enabled"

msgid "ui.diagnostics.disabled"
msgstr "Diagnostics disabled"


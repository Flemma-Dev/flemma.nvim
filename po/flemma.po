# Flemma UI catalogue — user-facing strings that never reach the model:
# notifications, prompts, picker titles. This is the translatable surface.
# Model-facing strings live in po/flemma-harness.po and are not translation
# material. Keys must stay unique across both files; flemma.messages
# enforces this at load time.
# All keys are namespaced under ui.* — the call-site marker that a string
# is user-facing; harness keys never use this prefix.
msgid ""
msgstr ""
"Project-Id-Version: flemma\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "ui.usage.no_data"
msgstr "No usage data for this buffer."

msgid "ui.rejection.prompt"
msgstr "Flemma: Rejection reason (optional): "

msgid "ui.rejection.reject_failed"
msgstr "Reject failed"

msgid "ui.rejection.no_tool_call"
msgstr "No tool call found"

#. Variables: {{ tool_id }} — the tool call's identifier.
msgid "ui.rejection.no_result_placeholder"
msgstr "No tool result placeholder for {{ tool_id }}"

#. Variables: {{ tool_id }} — the tool call's identifier.
msgid "ui.rejection.already_completed"
msgstr "Tool {{ tool_id }} has already completed"

#. Variables: {{ tool_id }} — the tool call's identifier.
msgid "ui.rejection.no_fence"
msgstr "No fence found in tool result for {{ tool_id }}"

#. Tool-action feedback, shared by the keymaps and the :Flemma sub-commands.
msgid "ui.tool.execute_failed"
msgstr "Execution failed"

msgid "ui.tool.background_failed"
msgstr "Failed to move tool to background"

msgid "ui.tool.backgrounded"
msgstr "Tool moved to background."

msgid "ui.tool.approve_failed"
msgstr "Approve failed"

msgid "ui.tool.no_pending_approve"
msgstr "No pending tools to approve"

#. Shown on a cancel keypress that cancelled nothing; a second press within
#. the double-tap window cancels every tool in the buffer.
msgid "ui.tool.nothing_to_cancel_retry"
msgstr "Nothing to cancel (press again to cancel all)"

# Flemma UI catalogue — user-facing strings that never reach the model:
# notifications, prompts, picker titles. This is the translatable surface.
# Model-facing strings live in po/flemma-harness.po and are not translation
# material. Keys must stay unique across both files; flemma.messages
# enforces this at load time.
# All keys are namespaced under ui.* — the call-site marker that a string
# is user-facing; harness keys never use this prefix.
msgid ""
msgstr ""
"Project-Id-Version: flemma\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


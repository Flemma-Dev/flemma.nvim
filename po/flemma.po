msgstr "  {{ tool_name }} ({{ tool_id }}) - started {{ seconds }}s ago"

#. :Flemma command dispatch and sub-command feedback.
#. Variables: {{ commands }} — comma-separated list of available commands.
msgid "ui.command.available"
msgstr "Available commands → {{ commands }}"

#. Variables: {{ command }} — the unrecognized command token.
msgid "ui.command.unknown"
msgstr "Unknown command '{{ command }}'"

#. Variables: {{ command }}, {{ suggestion }} — the closest known command.
msgid "ui.command.unknown_suggestion"
msgstr "Unknown command '{{ command }}'. Did you mean '{{ suggestion }}'?"

#. Variables: {{ command }} — a namespace node that has no action of its own.
msgid "ui.command.not_invokable"
msgstr "'{{ command }}' is not invokable"

#. Variables: {{ command }}, {{ subcommands }} — its available child commands.
msgid "ui.command.expects_subcommand"
msgstr "'{{ command }}' expects a sub-command ({{ subcommands }})"

#. Config action callbacks (on_request_start, on_request_complete, …).
#. Variables: {{ label }}, {{ reason }} — the callback name and failure detail.
msgid "ui.callback.failed"
msgstr "{{ label }} callback failed: {{ reason }}"

#. Variables: {{ label }}, {{ received }} — the callback name and the Lua type given.
msgid "ui.callback.invalid_type"
msgstr "{{ label }} expects a string or function, received {{ received }}"

#. Variables: {{ label }}, {{ reason }} — the callback name and failure detail.
msgid "ui.callback.command_failed"
msgstr "{{ label }} command failed: {{ reason }}"


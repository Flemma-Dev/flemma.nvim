msgid "ui.tool.all_cancelled"
msgstr "All tool executions cancelled"

msgid "ui.tool.list_header"
msgstr "Pending tool executions:"

#. Variables: {{ tool_name }}, {{ tool_id }}, {{ seconds }} — one pending row.
